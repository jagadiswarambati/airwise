# AirWise Environment Configuration
# Copy this file to .env and configure as needed.
# Do not commit real secrets to source control.

# LLM Configuration ('gemini' or 'none')
LLM_PROVIDER=none

# Gemini API Key (server-side only)
GEMINI_API_KEY=

# Gemini Model Name
GEMINI_MODEL=gemini-1.5-flash

# API Server Configuration
ALLOWED_ORIGIN=
RATE_LIMIT_PER_MIN=20
AIR_PRIMARY=open-meteo
AIR_CACHE_TTL_S=600

# Client Scenarios: 'live', 'clear', 'moderate', 'severe', 'stale'
VITE_DEFAULT_SCENARIO=live

