{
  "name": "airwise",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "validate": "npm run lint && npm run typecheck && npm run test && npm run check:ui && npm run check:css && npm run check:links && npm run check:size && npm run scan:secrets && npm run format:check",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:tz": "node scripts/run-tz-tests.mjs",
    "test:policy": "vitest run tests/policy/policy-matrix.test.ts tests/policy/mutation.test.ts",
    "test:matrix": "node scripts/run-matrix.mjs",
    "check:traceability": "node scripts/check-traceability.mjs",
    "check:ui": "node scripts/check-ui.mjs",
    "check:css": "node scripts/check-css.mjs",
    "check:links": "node scripts/check-links.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:size": "node scripts/check-size.mjs",
    "check:branches": "node scripts/check-branches.mjs",
    "scan:secrets": "node scripts/scan-secrets.mjs"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^18.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.16.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.16.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "globals": "^15.13.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0",
    "vite": "^6.4.6",
    "vitest": "^5.1.1"
  },
  "overrides": {
    "tinypool": "^2.1.2",
    "esbuild": "^0.25.0"
  }
}
